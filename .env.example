# Copy to .env and fill it in from your editor. Never paste keys in a chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FALLBACK_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
MAPBOX_TOKEN=
TELEGRAM_BOT_TOKEN=
ALCALDIAS=09003,09007
DEMO_MODE=0
# Frontend: public pk. token, URL-restricted in Mapbox. Vite reads it from web/.env (same name).
VITE_MAPBOX_TOKEN=
